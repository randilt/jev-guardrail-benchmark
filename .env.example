# Copy to .env and fill in. .env is git-ignored. Keys are never printed or written to results.

# --- Jev (TypeSafe AI)
JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest

# --- Azure AI Content Safety (Standard S0 resource)
AZURE_CS_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_CS_KEY=

# Instead of the four keys above, the Jev and Azure keys can be read from the gateway's config.toml
# (jev_apikey, jev_base_url, jev_model, azurecontentsafety_endpoint, azurecontentsafety_key):
# GATEWAY_CONFIG_TOML=/path/to/wso2apip-ai-gateway-1.2.0/configs/config.toml

# --- LLM judge: any OpenAI-compatible chat completions URL with no guardrails in front of it.
# Option A, through the gateway: an LLM provider route that has only api-key-auth
# JUDGE_URL=https://localhost:8443/<provider-context>/chat/completions?api-version=2024-10-21
# JUDGE_KEY_HEADER=X-API-Key
# JUDGE_UPSTREAM_HOST=<resource>.openai.azure.com
# Option B, Azure OpenAI directly
JUDGE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-10-21
JUDGE_KEY_HEADER=api-key
JUDGE_KEY=
# JUDGE_LABEL=gpt-4o-mini

# --- WSO2 AI Gateway
# GATEWAY_URL=https://localhost:8443
# GATEWAY_TLS_VERIFY=false
# GATEWAY_MGMT_URL=http://localhost:9090/api/management/v1
# GATEWAY_MGMT_USER=admin
# GATEWAY_MGMT_PASSWORD=admin
# The mock upstream as the gateway runtime container sees it
# MOCK_UPSTREAM_URL=http://bench-mock:8000/v1
# JEV_POLICY_VERSION=v0
# AZURE_POLICY_VERSION=v1

# --- Jev questions: the default copy in config/jev_questions.yaml, or read them from a policy checkout
# JEV_POLICY_DEFINITION=/path/to/gateway-controllers/policies/typesafe-jev-content-safety/policy-definition.yaml

# --- Budget and prices (check the pricing pages; these are the values used for the published run)
# JEV_BUDGET_USD=1.00
# PRICE_JEV_INPUT_PER_M=0.042
# PRICE_JUDGE_INPUT_PER_M=0.15
# PRICE_JUDGE_OUTPUT_PER_M=0.60
# PRICE_AZURE_CS_PER_1K_RECORDS=0.375
